        </div>
      </section>

      {/* Education Section */}
      <section id="education" className="py-20 px-4 max-w-6xl mx-auto border-t border-gray-200">
        <h2 className="text-4xl font-bold mb-12">Education</h2>
        
        <div className="space-y-6">
          {education.map((edu, idx) => (
            <div key={idx} className="border border-gray-200 rounded-lg p-8">
              <div className="flex justify-between items-start mb-2">
                <div>
                  <h3 className="text-2xl font-bold text-gray-900">{edu.degree}</h3>
                  <p className="text-lg text-gray-600 mt-1">{edu.field}</p>
                </div>
                <span className="px-4 py-2 bg-gray-100 text-gray-700 rounded-lg font-semibold text-sm">
                  {edu.status}
                </span>
              </div>
              <p className="text-gray-600 mt-4">{edu.details}</p>
            </div>
          ))}
        </div>

        <div className="mt-12 pt-12 border-t border-gray-200">
          <h3 className="text-2xl font-bold mb-6 flex items-center gap-2">
            <BookOpen size={28} /> Currently Learning
          </h3>
          <div className="grid md:grid-cols-2 gap-4">
            {learning.map((item, idx) => (
              <div key={idx} className="p-4 bg-gray-50 rounded-lg border border-gray-200">
                <p className="text-gray-900 font-medium">{item}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      {/* Skills Section */}
      <section id="skills" className="py-20 px-4 max-w-6xl mx-auto border-t border-gray-200">
        <h2 className="text-4xl font-bold mb-12">Skills & Technologies</h2>

        <div className="grid md:grid-cols-2 gap-8">
          {skills.map((skillGroup, idx) => (
            <div key={idx} className="border border-gray-200 rounded-lg p-8">
              <h3 className="text-xl font-bold mb-4 text-gray-900">{skillGroup.category}</h3>
              <div className="flex flex-wrap gap-2">
                {skillGroup.items.map((skill) => (
                  <span 
                    key={skill}
                    className="px-3 py-2 bg-gray-100 text-gray-700 rounded-full text-sm font-medium"
                  >
                    {skill}
                  </span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>

      {/* Contact Section */}
      <section id="contact" className="py-20 px-4 max-w-6xl mx-auto border-t border-gray-200">
        <div className="text-center space-y-8">
          <h2 className="text-4xl font-bold">Let's Connect</h2>
          
          <p className="text-gray-600 text-lg max-w-2xl mx-auto">
            Interested in collaborating on AI/ML projects or discussing MLOps practices? Feel free to reach out.
          </p>

          <div className="flex flex-col sm:flex-row justify-center gap-4">
            <a 
              href="mailto:snehallaldas@gmail.com"
              className="px-8 py-4 bg-gray-900 text-white rounded-lg font-medium hover:bg-gray-800 transition flex items-center justify-center gap-2"
            >
              <Mail size={20} /> Email
            </a>
            <a 
              href="https://github.com/Snehallaldas"
              target="_blank"
              rel="noopener noreferrer"
              className="px-8 py-4 border border-gray-900 text-gray-900 rounded-lg font-medium hover:bg-gray-50 transition flex items-center justify-center gap-2"
            >
              <Github size={20} /> GitHub
            </a>
            <a 
              href="https://linkedin.com/in/snehallaldas"
              target="_blank"
              rel="noopener noreferrer"
              className="px-8 py-4 border border-gray-900 text-gray-900 rounded-lg font-medium hover:bg-gray-50 transition flex items-center justify-center gap-2"
            >
              <Linkedin size={20} /> LinkedIn
            </a>
          </div>

          <p className="text-gray-500 text-sm">
            snehallaldas@gmail.com
          </p>
        </div>
      </section>

      {/* Footer */}
      <footer className="border-t border-gray-200 py-8 px-4 text-center text-gray-500">
        <p>© 2026 Snehal Das. Built with React & Tailwind CSS.</p>
      </footer>
    </div>
