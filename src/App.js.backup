                    {tech}
                  </span>
                ))}
              </div>
            </div>
          ))}
        </div>

        <div className="text-center mt-12 pt-12 border-t border-gray-200">
          <p className="text-gray-600 mb-4">See more on my GitHub</p>
          <a 
